# El HTML se sirve con max-age=0 must-revalidate, asi que el navegador siempre
# pide la pagina y recibe las urls selladas por tools/stamp-assets.py en el
# despliegue (?v=<commit>). Cada despliegue cambia la url, asi que todo lo que
# cuelga de ella se puede cachear un ano sin dejar a nadie con la version vieja.

/webfonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable
